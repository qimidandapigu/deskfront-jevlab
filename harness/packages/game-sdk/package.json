{
  "name": "@quickplay/game-sdk",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Game observation, intent and presentation client for quickplay-bridge/v1",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
