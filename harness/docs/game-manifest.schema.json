{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quickplay external game manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "id", "name", "description", "command", "capabilities"],
  "properties": {
    "protocol": { "const": "quickplay-game/v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cwd": { "type": "string" },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "maxSessions": { "type": "integer", "minimum": 1 },
    "startupTimeoutMs": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["human", "ai", "seed"],
      "properties": { "human": { "type": "boolean" }, "ai": { "type": "boolean" }, "seed": { "type": "boolean" } }
    },
    "variants": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } }
      }
    },
    "options": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["type"],
        "properties": {
          "type": { "enum": ["string", "number", "integer", "boolean"] },
          "description": { "type": "string" },
          "default": { "type": ["string", "number", "boolean"] },
          "enum": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } },
          "min": { "type": "number" }, "max": { "type": "number" }
        }
      }
    }
  }
}
