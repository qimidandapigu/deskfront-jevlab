# DeepSeek 官方接口：deepseek / analyst 慢脑默认使用 deepseek-flash，关闭思考
DEEPSEEK_API_KEY=
# 通用 MODEL_* 兼容参数；官方配置档使用上面的 DEEPSEEK_API_KEY
#MODEL_API_KEY=
#MODEL_CHAT_URL=https://api.deepseek.com/chat/completions
#MODEL_NAME=deepseek-flash
#MODEL_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 决策后端：mock | deepseek | jev | openrouter
SYSTEMONE_BACKEND=mock
# JGP 兼容入口的后端覆盖；不设则使用公共默认模型（无配置时 mock）
#JEV_BACKEND=
# Jev（TypeSafe System One，@typesafe-ai/sdk，SYSTEMONE_BACKEND=jev 时必需）
TYPESAFE_API_KEY=
#TYPESAFE_BASE_URL=
#TYPESAFE_DEFAULT_MODEL=jev-latest
# Jev 经 OpenRouter（SYSTEMONE_BACKEND=openrouter 时必需）
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai
#OPENROUTER_MODEL=typesafe/jev-1.13
# 代理（访问境外 API 时按需设置）
#HTTPS_PROXY=http://127.0.0.1:7890
# 观测站端口与开局前延时（毫秒，默认 3777 / 3000）
#VIEWER_PORT=3777
#VIEWER_START_DELAY_MS=3000
# 真人局空闲超时（毫秒，超时自动结束，默认 180000）
#VIEWER_HUMAN_IDLE_MS=180000
# 玩具兵打枪 demo 运行时长（秒）
#DEMO_SECONDS=8
# `jev run` 运行时长上限（秒，默认不限）
#JEV_RUN_SECONDS=
# 外部游戏注册清单（默认为 games.local.json）
#QUICKPLAY_GAMES_CONFIG=games.local.json
# Deskfront：默认发现相邻的 ../deskfront-jevlab，不存在时不注册
#DESKFRONT_ROOT=C:/game/deskfront-jevlab
#PYTHON_BIN=python
#GODOT_BIN=C:/path/to/godot.exe

# 可选语音：填写自己的密钥；音色需要账号开通相应权限。
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEECH_RATE=8
